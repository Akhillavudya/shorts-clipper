# Copy to .env and fill in. .env is gitignored; this file is not.

# --- LLM providers (config/settings.yaml maps tiers to these) ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- YouTube Data API v3: discovery + (later) upload ---
# 10,000 quota units/day per Cloud project. See FULL_PLAN.md section 3.
YOUTUBE_API_KEY=

# --- Podcast Index (free, RSS-side discovery) ---
PODCAST_INDEX_KEY=
PODCAST_INDEX_SECRET=

# --- YouTube OAuth: `clipper upload` and `clipper calibrate` ---
# These two act as the channel rather than reading public data, so an API key
# is not enough - they need OAuth.
#   upload    https://www.googleapis.com/auth/youtube.upload
#   calibrate https://www.googleapis.com/auth/yt-analytics.readonly
#
# Create an OAuth client of type *Desktop app* at
# https://console.cloud.google.com/apis/credentials, put its id and secret
# below, then run `clipper auth` once and paste the refresh token it prints.
# YOUTUBE_OAUTH_TOKEN is an alternative for a single run: a short-lived access
# token, used as-is and never refreshed.
YOUTUBE_OAUTH_TOKEN=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
